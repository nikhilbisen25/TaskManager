# Copy to .env and change values. Never commit .env.
# Shared HS256 secret: auth-service signs, task-service verifies. Must be >= 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRE_MINUTES=60

# Auth DB (authdb)
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth_local_pw
AUTH_DB_NAME=authdb

# Task DB (taskdb)
TASK_DB_USER=task
TASK_DB_PASSWORD=task_local_pw
TASK_DB_NAME=taskdb

# Port the browser uses (nginx in the frontend container)
FRONTEND_PORT=8080
